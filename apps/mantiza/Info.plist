<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Mantiza</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Mantiza talks to your Mantiza device over Bluetooth so it can tap and type for you.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Mantiza looks at the screen to see where to tap while it does a task for you.</string>
	<key>NSContactsUsageDescription</key>
	<string>Mantiza finds the person you name, so it can call or message them for you.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Mantiza adds the events you ask for to your calendar.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Mantiza adds the reminders you ask for.</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>Mantiza sets the alarms and timers you ask for.</string>
	<key>NSCameraUsageDescription</key>
	<string>Mantiza turns the flashlight on and off when you ask.</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
		<string>comgooglemaps</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.samratjagtap.Mantiza</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mantiza</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Development builds send task reports to the developer's computer on this Wi-Fi.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>screen-capture</string>
	</array>
</dict>
</plist>
